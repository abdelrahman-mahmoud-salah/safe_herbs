{
  "rewrites": [
    { "source": "/about", "destination": "/index.html" },
    { "source": "/products", "destination": "/index.html" },
    { "source": "/farms", "destination": "/index.html" },
    { "source": "/certificates", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    {"source":"/certificates" , "destination":"/allcertificates.html"}
  ],
  "headers": [
    {
      "source": "/css/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/image/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
